# Estas variables se cargan en Netlify:
#   Site configuration > Environment variables
# NUNCA subas a GitHub un archivo .env con valores reales.

# Access Token de Mercado Pago (secreto).
# Mercado Pago Developers > tu aplicación > Credenciales > pestaña "Prueba" para probar,
# y "Producción" cuando quieras cobrar de verdad.
MP_ACCESS_TOKEN=APP_USR-...

# Clave secreta de la firma de Webhooks (secreto).
# Mercado Pago Developers > tu aplicación > Webhooks > Clave secreta.
MP_WEBHOOK_SECRET=...

# Dirección pública de la tienda, sin barra al final. Ej: https://blackshout.com.ar
# Si no la cargás, se usa la dirección que Netlify le da al sitio.
APP_URL=https://tu-tienda.netlify.app
